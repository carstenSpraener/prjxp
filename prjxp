#!/usr/bin/env bash
# =============================================================================
# prjxp — Control script for the prjxp Docker pipeline
# =============================================================================
# Usage:
#   ./prjxp <project-path> chunk [--port 8090]
#     Chunk the project (skips if px-chunks.jsonl exists)
#   ./prjxp <project-path> embed [--port 8090]
#     Embed chunks (skips if .prjxp-data has content)
#   ./prjxp <project-path> mcp [--port 8090]
#     Chunk + embed + start MCP server (default command)
#   ./prjxp <project-path> stop
#     Stop the MCP server for a project
#   ./prjxp <project-path> clean
#     Delete px-chunks.jsonl, .prjxp-data/* and Docker image
#   ./prjxp rebuild
#     Rebuild the Docker image from scratch
# =============================================================================

set -euo pipefail

IMAGE_NAME="prjxp"
DEFAULT_PORT=7007
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# =============================================================================
# Parse arguments
# =============================================================================
PROJECT_PATH=""
PORT=$DEFAULT_PORT
COMMAND="mcp"

while [[ $# -gt 0 ]]; do
    case "$1" in
        stop)
            COMMAND="stop"
            shift
            if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
                PROJECT_PATH="$1"
                shift
            fi
            ;;
        rebuild)
            COMMAND="rebuild"
            shift
            ;;
        chunk|embed|mcp|clean)
            COMMAND="$1"
            shift
            if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
                PROJECT_PATH="$1"
                shift
            fi
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        -*)
            log_error "Unknown option: $1"
            exit 1
            ;;
        *)
            if [[ -z "$PROJECT_PATH" ]]; then
                PROJECT_PATH="$1"
            fi
            shift
            ;;
    esac
done

# =============================================================================
# Validation (rebuild doesn't need a project path)
# =============================================================================
if [[ "$COMMAND" != "rebuild" ]]; then
    if [[ -z "$PROJECT_PATH" ]]; then
        echo "Usage: $0 <project-path> [chunk|embed|mcp|clean] [--port 8090]"
        echo "       $0 stop <project-path>"
        echo "       $0 rebuild"
        exit 1
    fi

    PROJECT_PATH="$(cd "$PROJECT_PATH" && pwd)"
    PROJECT_NAME=$(basename "$PROJECT_PATH")

    if [[ ! -d "$PROJECT_PATH" ]]; then
        log_error "Project directory does not exist: $PROJECT_PATH"
        exit 1
    fi
fi

# =============================================================================
# Helper: ensure Docker image exists (auto-build if needed)
# =============================================================================
ensure_image() {
    log_info "Checking for Docker image '${IMAGE_NAME}'..."
    if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        log_warn "Image not found. Building from ${SCRIPT_DIR}..."
        (cd "$SCRIPT_DIR" && docker build -t "$IMAGE_NAME" .)
        log_info "Image built successfully."
    else
        log_info "Image '${IMAGE_NAME}' already exists."
    fi
}

# =============================================================================
# Command: chunk
# =============================================================================
cmd_chunk() {
    if [[ -f "$PROJECT_PATH/px-chunks.jsonl" ]]; then
        log_info "px-chunks.jsonl already exists — skipping chunking."
        return 0
    fi

    ensure_image

    log_info "=== Chunking source code ==="
    docker run --rm \
        -v "$PROJECT_PATH:/app-source" \
        -e PRJXP_ROOT_DIR=/app-source \
        -e SKIP_EMBEDDING_SERVER=true \
        "$IMAGE_NAME" chunk

    if [[ ! -f "$PROJECT_PATH/px-chunks.jsonl" ]]; then
        log_error "Chunking failed — px-chunks.jsonl not created."
        exit 1
    fi

    CHUNK_COUNT=$(wc -l < "$PROJECT_PATH/px-chunks.jsonl")
    log_info "Created $CHUNK_COUNT chunks in px-chunks.jsonl"
}

# =============================================================================
# Command: embed
# =============================================================================
cmd_embed() {
    if [[ -d "$PROJECT_PATH/.prjxp-data" ]] && [[ -n "$(ls -A "$PROJECT_PATH/.prjxp-data" 2>/dev/null)" ]]; then
        log_info ".prjxp-data already has content — skipping embedding."
        return 0
    fi

    ensure_image

    log_info "=== Embedding chunks into Lucene index ==="
    docker run --rm \
        -v "$PROJECT_PATH:/app-source" \
        -v "$PROJECT_PATH/.prjxp-data:/app-source/.prjxp-data/lucene-index" \
        -e PRJXP_ROOT_DIR=/app-source \
        "$IMAGE_NAME" embed

    log_info "Embedding complete."
}

# =============================================================================
# Command: stop
# =============================================================================
cmd_stop() {
    log_info "Stopping MCP server for project '$PROJECT_NAME'..."
    if docker ps --format '{{.Names}}' | grep -q "mcp-${PROJECT_NAME}"; then
        docker stop "mcp-${PROJECT_NAME}" && docker rm "mcp-${PROJECT_NAME}"
        log_info "MCP server stopped."
    else
        log_warn "No running MCP server found for project '$PROJECT_NAME'."
    fi
}

# =============================================================================
# Command: clean
# =============================================================================
cmd_clean() {
    log_info "Cleaning up project '$PROJECT_NAME'..."

    if [[ -f "$PROJECT_PATH/px-chunks.jsonl" ]]; then
        rm "$PROJECT_PATH/px-chunks.jsonl"
        log_info "Deleted px-chunks.jsonl"
    fi

    if [[ -d "$PROJECT_PATH/.prjxp-data" ]]; then
        rm -rf "${PROJECT_PATH}/.prjxp-data/*"
        log_info "Cleared .prjxp-data contents"
    fi

    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        docker rmi "$IMAGE_NAME"
        log_info "Removed Docker image '${IMAGE_NAME}'"
    else
        log_warn "No Docker image '${IMAGE_NAME}' found to remove."
    fi

    # Also stop the MCP container if it's still running
    cmd_stop
}

# =============================================================================
# Command: rebuild
# =============================================================================
cmd_rebuild() {
    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        log_warn "Existing image found. Removing before rebuild..."
        docker rmi "$IMAGE_NAME"
    fi

    log_info "Building Docker image '${IMAGE_NAME}' from ${SCRIPT_DIR}..."
    (cd "$SCRIPT_DIR" && docker build -t "$IMAGE_NAME" .)
    log_info "Image rebuilt successfully."
}

# =============================================================================
# Command: mcp (chunk + embed + serve)
# =============================================================================
cmd_mcp() {
    # Copy config files if not present
    if [[ ! -f "$PROJECT_PATH/application.yaml" ]]; then
        log_info "Copying application.yaml to project directory..."
        cp "$SCRIPT_DIR/application.yaml" "$PROJECT_PATH/application.yaml"
    fi

    if [[ ! -f "$PROJECT_PATH/.env" ]]; then
        log_info "Copying .env.example to project directory as .env..."
        cp "$SCRIPT_DIR/.env.example" "$PROJECT_PATH/.env"
    fi

    cmd_chunk
    cmd_embed

    log_info "=== Starting MCP server on port $PORT ==="

    # Stop existing container if running
    if docker ps --format '{{.Names}}' | grep -q "mcp-${PROJECT_NAME}"; then
        log_warn "Existing MCP server found for '$PROJECT_NAME'. Stopping..."
        docker stop "mcp-${PROJECT_NAME}" && docker rm "mcp-${PROJECT_NAME}"
    fi

    docker run -d \
        --name "mcp-${PROJECT_NAME}" \
        -v "$PROJECT_PATH:/app-source" \
        -v "$PROJECT_PATH/.prjxp-data:/app-source/.prjxp-data/lucene-index" \
        -p "${PORT}:7007" \
        -e PRJXP_ROOT_DIR=/app-source \
        -e SERVER_PORT=7007 \
        "$IMAGE_NAME" serve

    # Wait for server to be ready
    log_info "Waiting for MCP server to start..."
    for i in $(seq 1 30); do
        if curl -s "http://localhost:${PORT}/prjxp/tools/ping" >/dev/null 2>&1; then
            break
        fi
        sleep 1
    done

    PING_RESULT=$(curl -s "http://localhost:${PORT}/prjxp/tools/ping" 2>/dev/null || echo "failed")

    if [[ "$PING_RESULT" == *"pong"* ]]; then
        log_info "=== MCP server is running! ==="
        log_info "  Project: $PROJECT_NAME"
        log_info "  URL:     http://localhost:${PORT}"
        log_info "  Ping:    $PING_RESULT"
    else
        log_warn "Server started but ping failed. Check logs: docker logs mcp-${PROJECT_NAME}"
    fi

    log_info "To stop the server later: $0 stop $PROJECT_PATH"
}

# =============================================================================
# Dispatch command
# =============================================================================
case "$COMMAND" in
    chunk)   cmd_chunk ;;
    embed)   cmd_embed ;;
    mcp)     cmd_mcp ;;
    stop)    cmd_stop ;;
    clean)   cmd_clean ;;
    rebuild) cmd_rebuild ;;
esac
