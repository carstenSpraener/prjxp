# Docker build context exclusions

# Version control
.git/
.gitignore

# Build outputs
build/
*/build/
**/build/
*.jar
*.war

# IDE
.idea/
.vscode/
*.iml

# Docker artifacts (no longer needed)
docker-dist/

# Apache deployment configs (bind-mounted into the httpd container, not part of the image).
# NOTE: docker/application.yaml.docker is NOT excluded — it is baked into the hub image.
/docker/apache-*.conf

# Lucene dev data
.lucenedb/
lucene-index/

# OS files
.DS_Store
Thumbs.db

# Docs (not needed in build)
docs/
