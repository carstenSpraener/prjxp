# .env template for prjxp projects — copy to .env and adjust as needed

# Optional: docker-compose can load a dedicated file via PRJXP_ENV_FILE.
# PRJXP_ENV_FILE=./.env

# Docker image tag for the prebuilt GHCR images (docker-compose.yml).
# Defaults to "latest"; pin a release, e.g. v0.9.0.
# PRJXP_VERSION=v0.9.0

LUCENE_INDEX_PATH=.prjxp-data/lucene-index
LUCENE_VECTOR_DIMENSION=1024
SERVER_PORT=7007
EMBEDDING_API_KEY=dummy
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# PRJXP_TRANSFER_PASSWORD=RömmelBrömms
# PRJXP_HUB_GITHUB_TOKEN_KEY=change-me   # passphrase for encrypting GitHub PATs stored in prjxp.yaml
