# Docker Compose environment variables for prjxp
# Copy this file to .env and adjust the values:  cp .env.docker .env

# ── Required ────────────────────────────────────────────────────────────────

# Path on your host machine containing projects to be scanned by the Hub
# (live projects are detected via a prjxp.yaml marker file; tar archives
# dropped here are imported).
#
# Shipped as "./" = the directory of docker-compose.yml. Docker Compose does
# NOT expand shell syntax in .env files — "$(pwd)" would be taken literally
# and fail — so "./" is the closest working form of "my current directory":
# it equals your cwd when you run "docker compose up" from that directory.
# Point this at a real projects folder for production use.
PROJECTS_HOME=./

# API key for your embedding provider (LM Studio accepts any non-empty value)
EMBEDDING_API_KEY=your-embedding-api-key

# ── Embedding provider (defaults match LM Studio on the host) ──────────────

# OpenAI-compatible endpoint, as seen from INSIDE the containers
EMBEDDING_API_BASE_URL=http://host.docker.internal:1234/v1

# Embedding model name — must match LUCENE_VECTOR_DIMENSION
# (mxbai-embed-large-v1 = 1024 dims)
EMBEDDING_MODEL_NAME=mxbai-embed-large-v1

# Vector dimension of the Lucene index — must equal your model's output
LUCENE_VECTOR_DIMENSION=1024

# ── Optional (defaults shown) ───────────────────────────────────────────────

# Host port of the Apache reverse proxy (Web UI entry point)
# APACHE_PORT=80

# Host port of the MCP endpoint (http://localhost:7007/mcp)
# HUB_PORT=7007

# API proxy upstream of the frontend (scheme + backend service name + port,
# as seen from inside the Docker network). Only needed if your backend runs
# under a different service name/port than "hub", e.g.:
# PRJXP_HUB_URL=http://osb-mcp:8080

# Allowed CORS origins for the REST API (comma-separated, NO spaces).
# Browsers send an Origin header on POST/PUT/DELETE — non-matching origins
# are rejected with 403. Add your public hostname when the Web UI is served
# under a different name/scheme than localhost, e.g.:
# MCP_CORS_ALLOWED_PATTERNS=http://localhost:*,https://prjxp.example.com
