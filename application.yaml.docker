prjxp:
  # which project to work on if none is on command line.
  activeProject: "cwd"

  projects:
    - name: cwd
      rootDir: /app-source
      jsonlFile: "px-chunks.jsonl"
      chunoWhiteList: "cs,vb,java,ts"
      tibedBatchSize: 50
      tibedResetStore: true

  # Embedding model type: ollama or onnx_local
  # Embedding store type: lucene or chroma
  embeddingStoreType: ${EMBEDDING_STORE_TYPE:lucene}
  embeddingServerScriptPath: "/app/prjxp-common/embedding-server/scripts/embedding-server.py"
  embeddingServerModelPath: "/app/prjxp-common/embedding-server/models/model.onnx"
  embeddingServerModelsDir: "/app/prjxp-common/embedding-server/models"
  embeddingStoreLucene:
    indexPath: ${LUCENE_INDEX_PATH:/app-source/.prjxp-data/lucene-index}
    vectorDimension: ${LUCENE_VECTOR_DIMENSION:1024}

  embedding:
    type: "ONNX_LOCAL"
    apiBaseURL: "http://localhost:1234/v1"
    modelName: "model.onnx"
    timeout: 180

  embeddingStores:
    - projectName: cwd
      providerUrl: http://localhost:8000
      tenant: prjxp
      dbName: prjxp
      collectionName: prjxp-src
      isDefault: true

mcp:
  cors:
    allowed-patterns: "http://10.*.*.*,http://172.16.*.*,http://192.168.*.*,http://localhost:*"

server:
  port: ${SERVER_PORT:7007}
  forward-headers-strategy: framework

spring:
  main:
    allow-bean-definition-overriding: true
  devtools:
    restart:
      additional-exclude: "**/package-info.java"
  ai:
    mcp:
      server:
        protocol: STATELESS
        transport: sse
