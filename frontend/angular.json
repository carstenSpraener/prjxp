{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "prjxp-frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "baseHref": "/prjxp/",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css",
              "node_modules/prismjs/themes/prism-tomorrow.css",
              "node_modules/katex/dist/katex.min.css"
            ],
            "scripts": [
              "node_modules/prismjs/prism.js",
              "node_modules/prismjs/components/prism-java.min.js",
              "node_modules/prismjs/components/prism-javascript.min.js",
              "node_modules/prismjs/components/prism-typescript.min.js",
              "node_modules/prismjs/components/prism-csharp.min.js",
              "node_modules/prismjs/components/prism-vbnet.min.js",
              "node_modules/prismjs/components/prism-groovy.min.js",
              "node_modules/prismjs/components/prism-json.min.js",
              "node_modules/prismjs/components/prism-bash.min.js"
            ]
          },
          "configurations": {
            "production": {
              "baseHref": "/prjxp/",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "src/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "prjxp-frontend:build:production"
            },
            "development": {
              "buildTarget": "prjxp-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": ["src/setup-tests.ts"],
            "coverageInclude": [
              "src/app/app.ts",
              "src/app/app.html",
              "src/app/app.routes.ts",
              "src/app/services/setup.service.ts",
              "src/app/services/globals.service.ts",
              "src/app/features/setup/setup-wizard.component.*",
              "src/app/features/setup/setup-validators.ts",
              "src/app/features/setup/setup-fixtures.ts",
              "src/app/models/setup.model.ts",
              "src/app/models/embedding-config.model.ts",
              "src/app/features/setup/steps/setup-form.ts",
              "src/app/features/setup/steps/setup-*-step.component.*",
              "src/app/features/dashboard/dashboard.component.*",
              "src/app/features/globals/globals.component.*",
              "src/app/components/setup-status-banner/setup-status-banner.component.*",
              "src/app/components/embedding-model-card/embedding-model-card.component.*",
              "src/app/components/embedding-model-editor-dialog/embedding-model-editor-dialog.component.*",
              "src/app/components/chat-model-editor-dialog/chat-model-editor-dialog.component.*"
            ],
            "coverageThresholds": {"perFile": true, "lines": 80},
            "coverageReporters": ["text", "html", "json", "json-summary", "lcov"]
          }
        }
      }
    }
  }
}
